func TestRouter_ProductionModelsIncludeAllBAIModels(t *testing.T) {
	r := New("openai", "deepseek-v4-flash")
	want := map[string]bool{"deepseek-v4-flash": true, "mimo-v2.5": true, "hy3": true, "deepseek-v4-flash-vision-exp": true}
	got := map[string]bool{}
	for _, model := range r.Models() {
		if want[model.ID] {
			got[model.ID] = model.Provider == "openai"
		}
	}
	for id := range want {
		if !got[id] {
			t.Fatalf("production model %q is not registered with openai provider", id)
		}
	}
}

func TestRouter_ProductionModelsExcludeGPT4oMini(t *testing.T) {
	for _, model := range New("openai", "deepseek-v4-flash").Models() {
		if model.ID == "gpt-4o-mini" {
			t.Fatal("gpt-4o-mini must not be a production candidate")
		}
	}
}

func TestRouter_AutoModelSelectsBestCandidate(t *testing.T) {
	r := New("openai", "deepseek-v4-flash")
	req := providers.ChatCompletionRequest{Model: "AUTO", Messages: []providers.ChatMessage{{Role: "user", Content: "hello"}}}
	decision := r.Decide(req)
	if decision.Model == "" || decision.Provider == "" {
		t.Fatalf("AUTO routing returned empty model/provider: %+v", decision)
	}
	if decision.RouteMode != "auto" && decision.RouteMode != "model" {
		t.Fatalf("AUTO routing should use auto mode, got %s", decision.RouteMode)
	}
}

func TestRouter_AutoNotSelectedAsCandidate(t *testing.T) {
	r := New("openai", "deepseek-v4-flash")
	// Literal AUTO request must never resolve to provider=auto (self-recursion).
	d := r.Decide(providers.ChatCompletionRequest{Model: "AUTO", Messages: []providers.ChatMessage{{Role: "user", Content: "hello"}}})
	if d.Provider == "auto" || d.Model == "AUTO" {
		t.Fatalf("AUTO routing must pick a real model, got %s/%s", d.Provider, d.Model)
	}
	if d.Provider == "" || d.Model == "" {
		t.Fatalf("AUTO routing returned empty: %+v", d)
	}
}
